# ==============================================================================
# HOOLA HOLIDAY BALI - ENVIRONMENT VARIABLES CONFIGURATION (TEMPLATE)
# (Salin ke .env untuk lokal, dan masukkan ke Cloudflare Pages Dashboard -> Settings -> Environment Variables)
# ==============================================================================

# APP & RUNTIME URL
APP_URL="http://localhost:3000"

# MIDTRANS PAYMENT GATEWAY CREDENTIALS (SANDBOX ENVIRONMENT)
# Dapatkan Server Key, Client Key, dan Merchant ID dari Midtrans Dashboard:
# URL: https://dashboard.sandbox.midtrans.com/ -> Settings -> Access Keys
MIDTRANS_SERVER_KEY="SB-Mid-server-YOUR_SERVER_KEY_HERE"
MIDTRANS_CLIENT_KEY="SB-Mid-client-YOUR_CLIENT_KEY_HERE"
MIDTRANS_MERCHANT_ID="YOUR_MERCHANT_ID_HERE"
MIDTRANS_IS_PRODUCTION="false"

# RESEND EMAIL API (REKOMENDASI UTAMA UNTUK CLOUDFLARE PAGES / WORKERS)
# Dapatkan API Key gratis di https://resend.com/api-keys (diawali 're_...')
# Mendukung pengiriman email otomatis via HTTP REST API di edge serverless Cloudflare tanpa raw SMTP socket.
RESEND_API_KEY=""
RESEND_FROM="Hoola Holiday Bali <booking@balinikitour.biz.id>"
ADMIN_EMAIL="nusawebworks@gmail.com"

# GMAIL SMTP NOTIFICATION CREDENTIALS (OPSIONAL FALLBACK UNTUK NODE.JS)
SMTP_USER="nusawebworks@gmail.com"
SMTP_PASS="YOUR_GOOGLE_APP_PASSWORD_HERE"
